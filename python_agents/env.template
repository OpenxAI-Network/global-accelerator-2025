# Aegis Multi-Agent AI System Environment Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
APP_NAME="Aegis Multi-Agent AI System"
APP_VERSION="1.0.0"
DEBUG=false
ENVIRONMENT="development"

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_URL="redis://localhost:6379"
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY=1.0
REDIS_MAX_QUEUE_SIZE=10000

# =============================================================================
# NEO4J CONFIGURATION
# =============================================================================
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="your_neo4j_password"
NEO4J_MAX_CONNECTIONS=50
NEO4J_CONNECTION_TIMEOUT=30

# =============================================================================
# CHROMADB CONFIGURATION
# =============================================================================
CHROMA_HOST="localhost"
CHROMA_PORT=8000
CHROMA_PERSIST_DIRECTORY="./chroma_db"
CHROMA_ANONYMIZED_TELEMETRY=false

# =============================================================================
# AI MODEL CONFIGURATION
# =============================================================================
# Required: Google Gemini API key
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL_NAME="gemini-2.5-pro"
GEMINI_MAX_TOKENS=8192
GEMINI_TEMPERATURE=0.1
GEMINI_TOP_P=0.8

# Optional: OpenAI API key
OPENAI_API_KEY="your_openai_api_key_here"
OPENAI_MODEL_NAME="gpt-4"
OPENAI_MAX_TOKENS=4096

# Optional: Anthropic API key
ANTHROPIC_API_KEY="your_anthropic_api_key_here"
ANTHROPIC_MODEL_NAME="claude-3-sonnet"

# =============================================================================
# EMBEDDING MODEL CONFIGURATION
# =============================================================================
EMBEDDING_MODEL="all-MiniLM-L6-v2"
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=32

# =============================================================================
# BLOCKCHAIN CONFIGURATION
# =============================================================================
# Supported blockchain chain IDs (comma-separated)
SUPPORTED_CHAINS="1,56,137,42161,10,8453,1101,59144"

# Blockchain RPC URLs (JSON format)
BLOCKCHAIN_RPC_URLS='{"1":"https://mainnet.infura.io/v3/YOUR_INFURA_KEY","56":"https://bsc-dataseed.binance.org/","137":"https://polygon-rpc.com/","42161":"https://arb1.arbitrum.io/rpc","10":"https://mainnet.optimism.io","8453":"https://mainnet.base.org","1101":"https://rpc.polygon-zkevm.gateway.fm","59144":"https://rpc.linea.build"}'

# =============================================================================
# ZETACHAIN CONFIGURATION
# =============================================================================
ZETA_RPC_URL="https://zetachain-athens-evm.blockpi.network/v1/rpc/public"
ZETA_CHAIN_ID=7000

# ZetaChain contract addresses (JSON format)
ZETA_CONTRACT_ADDRESSES='{"universal_security":"0x1234567890123456789012345678901234567890","lending_pool":"0x2345678901234567890123456789012345678901","voice_processor":"0x3456789012345678901234567890123456789012"}'

# =============================================================================
# HUMAN-IN-THE-LOOP (HITL) CONFIGURATION
# =============================================================================
HITL_AUTO_ESCALATION=true
HITL_MAX_APPROVAL_TIME=60
HITL_EMERGENCY_APPROVERS="emergency_admin,security_manager"

# =============================================================================
# AGENT CONFIGURATION
# =============================================================================
AGENT_HEALTH_CHECK_INTERVAL=30
AGENT_MAX_PROCESSING_TIME=300
AGENT_BATCH_SIZE=100
AGENT_MAX_RETRIES=3

# =============================================================================
# PERFORMANCE CONFIGURATION
# =============================================================================
MAX_CONCURRENT_EVENTS=1000
EVENT_PROCESSING_TIMEOUT=60
THREAT_ANALYSIS_TIMEOUT=30
ACTION_EXECUTION_TIMEOUT=120

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL="INFO"
LOG_FILE="logs/aegis_system.log"
LOG_ROTATION="100 MB"
LOG_RETENTION="30 days"

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
API_RATE_LIMIT=1000
MAX_REQUEST_SIZE=10485760
CORS_ORIGINS="http://localhost:3000,https://aegis.ai"

# =============================================================================
# MONITORING CONFIGURATION
# =============================================================================
METRICS_ENABLED=true
METRICS_INTERVAL=60
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30

# =============================================================================
# CACHE CONFIGURATION
# =============================================================================
CACHE_ENABLED=true
CACHE_TTL=300
CACHE_MAX_SIZE=10000

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DATABASE_CONNECTION_POOL_SIZE=20
DATABASE_CONNECTION_TIMEOUT=30
DATABASE_QUERY_TIMEOUT=60

# =============================================================================
# NOTES
# =============================================================================
# 1. Replace all "your_*_key_here" values with your actual API keys
# 2. Update RPC URLs with your own endpoints if needed
# 3. Update contract addresses with actual deployed contract addresses
# 4. Adjust performance settings based on your infrastructure
# 5. Set appropriate passwords for Redis and Neo4j
# 6. Ensure all required services (Redis, Neo4j, ChromaDB) are running
